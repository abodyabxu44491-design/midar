{
  "name": "midar",
  "version": "2.5.0",
  "description": "مدار | MIDAR — منصة إدارة المدارس. برمجة وتطوير: المبرمج عبدالله السكني",
  "author": "Abdullah Al-Sakkani (عبدالله السكني)",
  "license": "SEE LICENSE IN LICENSE",
  "copyright": "Copyright (c) 2026 Abdullah Al-Sakkani. All rights reserved.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:showcase": "node scripts/seed-showcase.js",
    "owner:password": "node scripts/owner-password.js",
    "credential:key": "node scripts/credential-key.js",
    "owner:totp": "node scripts/owner-totp.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint .",
    "test:coverage": "mkdir -p coverage && NODE_ENV=test node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=94 --test-coverage-branches=80 --test-coverage-functions=89 --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.1",
    "qrcode-generator": "^2.0.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "main": "src/server.js",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
