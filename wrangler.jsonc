// Midar on Cloudflare Workers (docs/cloudflare/PHASE-2-DESIGN.md).
// Build first: npm run workers:build. Secrets are never written here: `wrangler secret put NAME --env <env>`;
// for local development they go in .dev.vars (not committed).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midar-api",
  "main": "workers/api.js",
  "compatibility_date": "2026-10-19",
  "upload_source_maps": true,
  "alias": {
    "fs": "./workers/fs-shim.js",
    "node:fs": "./workers/fs-shim.js",
    // body-parser's iconv-lite 0.4 calls its stream extension unconditionally on Node-like runtimes, but the bundler
    // takes its browser build, which has none. 0.6.3 has the same API and checks first. Node keeps 0.4.
    "iconv-lite": "iconv-lite-workers"
  },
  // The bundle is one module without a file URL. The app only uses import.meta.url to find public/ and package.json,
  // which workers/fs-shim.js resolves by name, so any path two levels deep works.
  "define": { "import.meta.url": "\"file:///bundle/src/core/module.js\"" },
  "assets": {
    "directory": "dist/workers/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  "vars": {
    "NODE_ENV": "production",
    "COOKIE_SECURE": "true",
    "SESSION_COOKIE_MODE": "separate",
    "TRUST_PROXY": "1"
  },
  // Local development: wrangler reads the database address from
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead of this id.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "env": {
    "staging": {
      "name": "midar-api-staging",
      "define": { "import.meta.url": "\"file:///bundle/src/core/module.js\"" },
      "workers_dev": true,
      "vars": {
        "NODE_ENV": "production",
        "COOKIE_SECURE": "true",
        "SESSION_COOKIE_MODE": "separate",
        "TRUST_PROXY": "1"
      },
      // Filled in when the staging Hyperdrive is created (docs/cloudflare/PHASE-3-REPORT.md).
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }]
    }
  }
}
