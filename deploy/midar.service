[Unit]
Description=MIDAR school platform
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=midar
WorkingDirectory=/opt/midar
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
