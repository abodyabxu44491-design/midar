# Midar (مدار) - School Management Platform
# Copyright (c) 2026 Abdullah Al-Sakkani (عبدالله السكني). All rights reserved.
# Proprietary and confidential. Unauthorized copying or distribution is prohibited.
#
# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://midarschool.com

# Database (the app role is restricted by row-level security; migrations use the owner role)
DATABASE_URL=postgres://midar_app:CHANGE_ME@localhost:5432/midar
MIGRATION_DATABASE_URL=postgres://midar_owner:CHANGE_ME@localhost:5432/midar
DATABASE_SSL=false

# Owner panel (npm run owner:password / npm run owner:totp)
OWNER_PATH=/change-this-secret-path
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
OWNER_ALLOWED_IPS=

# Encryption key for stored credentials (npm run credential:key)
CREDENTIAL_KEY=

# Web push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AI assistant (optional)
ANTHROPIC_API_KEY=
AI_MODEL=

# Android app (Google Play, optional)
ANDROID_PACKAGE=
ANDROID_SHA256=

COOKIE_SECURE=true
SESSION_COOKIE_MODE=separate
FIREBASE_ANALYTICS=false
TRUST_PROXY=1
