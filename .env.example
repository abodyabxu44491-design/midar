# =====================================================================
# مِدار — إعدادات البيئة
#   التطوير المحلي: انسخ هذا الملف باسم .env.local
#   سيرفر خاص:      انسخه باسم .env
#   Firebase:        القيم العامة في .env.midar-714c1 والأسرار في Secret Manager
# =====================================================================
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://midar.example.com

# قاعدة البيانات
DATABASE_URL=postgres://midar_app:APP_PASSWORD@127.0.0.1:5432/midar
MIGRATION_DATABASE_URL=postgres://midar_owner:OWNER_PASSWORD@127.0.0.1:5432/midar
DATABASE_SSL=false
# على Firebase فقط: project:region:instance
CLOUD_SQL_INSTANCE=

# لوحة المالك
OWNER_PATH=/control-اكتب-رابطًا-سريًا-طويلًا
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=          # npm run owner:password
OWNER_TOTP_SECRET=            # npm run owner:totp  (إلزامي في الإنتاج؛ الاستثناء المؤقت: OWNER_ALLOW_NO_TOTP=true)
OWNER_ALLOWED_IPS=

# الجلسات
COOKIE_SECURE=true
SESSION_COOKIE_MODE=separate  # single على Firebase
TRUST_PROXY=1

# تحليلات Firebase في الصفحات العامة
FIREBASE_ANALYTICS=false
